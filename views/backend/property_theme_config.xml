<odoo>
    <data>
        <record id="property_theme_config_view_form" model="ir.ui.view">
            <field name="name">property.theme.config.view.form</field>
            <field name="model">property.theme.config</field>
            <field name="arch" type="xml">
                <form string="Property Theme Configuration">
                    <sheet>
                        <h3>
                            <field name="name" readonly="1" force_save="1"/>
                        </h3>
                        <group string="Google Map API Key">
                            <group>
                                <field name="google_map_api" password="true"/>
                            </group>
                        </group>
                        <group string="Map Center Coordination">
                            <group>
                                <field name="map_center_address"/>
                            </group>
                            <group>
                                <group>
                                    <field name="latitude" placeholder="-90.00000000"/>
                                </group>
                                <group>
                                    <field name="longitude" placeholder="-180.00000000"/>
                                </group>
                            </group>
                            <group>
                                <field name="zoom_level"/>
                            </group>
                        </group>
                        <group string="Website RTL Config">
                            <group>
                                <field name="is_rtl"/>
                            </group>
                        </group>
                        <group string="Show Landlord on Property">
                            <group>
                                <field name="display_landlord" string="Show Landlord on Property in Website"/>
                            </group>
                        </group>
                        <group string="Listing Property per page">
                            <group>
                                <field name="list_property_per_page"/>
                            </group>
                        </group>
                        <group string="Lisiting Filters">
                            <group string="Price Range Filters">
                                <field name="price_start"/>
                                <field name="price_end"/>
                                <field name="filter_currency_id" options="{'no_create': True}"/>
                            </group>
                            <group string="Area Range Filters">
                                <field name="area_start"/>
                                <field name="area_end"/>
                            </group>
                        </group>
                        <group>
                            <group string="Pricing Display Type" name="pricing_display_type">
                                <field name="pricing_display_type" widget="radio" options="{'horizontal': True}"/>
                            </group>
                            <group string="Pricing Format" name="pricing_formate">
                                <field name="pricing_type" widget="radio" options="{'horizontal': True}"/>
                            </group>
                        </group>
                        <group string="Website Newsletter">
                            <group>
                                <field name="mailling_list_id"/>
                            </group>
                        </group>
                        <group string="Property Listing Configurations">
                            <group>
                                <field name="is_latest_listing_visible"/>
                                <field name="no_latest_list" invisible="not is_latest_listing_visible"/>
                            </group>
                            <group>
                                <field name="is_popular_properties_visible"/>
                                <field name="no_popular_list" invisible="not is_popular_properties_visible"/>
                            </group>
                        </group>
                        <group string="Home stats figure">
                            <group>
                                <field name="hs_one"/>
                                <field name="hs_two"/>
                            </group>
                            <group>
                                <field name="hs_three"/>
                                <field name="hs_four"/>
                            </group>
                        </group>
                        <group string="Home Video Link">
                            <group>
                                <field name="video_link"/>
                            </group>
                        </group>
                        <group string="Website Visibility" name="website_visibility">
                            <group>
                                <field name="visible_accommodation"/>
                                <field name="visible_three_sixty_view"/>
                            </group>
                            <group>
                                <field name="visible_floor_plans"/>
                                <field name="enquiry_submitted_on_logged_out"/>
                            </group>
                        </group>
                        <group string="Listing Page Configuration" name="listing_page_configuration">
                            <group>
                                <field name="listing_section_background" class="oe_avatar" widget="image"/>
                            </group>
                        </group>
                        <group string="Send Mail To Landlord While Enquiry" name="send_mail_to_landlord_while_enquiry">
                            <group>
                                <field name="is_mail_send_to_landlord"/>
                            </group>
                        </group>
                        <group>
                            <group string="Whatsapp Message Configuration" name="whatsapp_message_configuration">
                                <field name="is_user_send_whatsapp_messages"/>
                                <field name="whatsapp_number" widget="phone"
                                       invisible="not is_user_send_whatsapp_messages"
                                       required="is_user_send_whatsapp_messages"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="reviews" string="Reviews">
                                <field name="review_ids" nolabel="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="role"/>
                                        <field name="rate"/>
                                        <field name="reviews"/>
                                    </list>
                                    <form>
                                        <field name="image_1920" class="oe_avatar" widget="image" nolabel="1"/>
                                        <group>
                                            <group class="p-0">
                                                <field name="name"/>
                                            </group>
                                        </group>
                                        <group>
                                            <group class="p-0">
                                                <field name="role"/>
                                                <field name="rate"/>
                                            </group>
                                        </group>
                                        <group>
                                            <field name="reviews"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page name="city" string="Cities">
                                <field name="city_ids" nolabel="1">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="city_id"/>
                                        <field name="size"/>
                                        <field name="property_count"/>
                                        <field name="tag_line"/>
                                    </list>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="city_id"/>
                                                <field name="size"/>
                                                <field name="tag_line"/>
                                                <field name="config_id" invisible="1"/>
                                            </group>
                                            <group>
                                                <field name="cover_image" class="oe_avatar" widget="image" nolabel="1"/>
                                            </group>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page name="partners" string="Partners">
                                <field name="partner_ids" nolabel="1">
                                    <list>
                                        <field name="name"/>
                                    </list>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                            </group>
                                            <group>
                                                <field name="partner_logo" class="oe_avatar" widget="image"
                                                       nolabel="1"/>
                                            </group>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page name="bg_images" string="Home Page Backgrounds">
                                <group col="4">
                                    <group>
                                        <field name="hero_choice" widget="radio"/>
                                    </group>
                                </group>
                                <group col="4" invisible="hero_choice != 'vid'">
                                    <group>
                                        <field name="video_bg_url"
                                               placeholder="https://your-site.com/video/bg-video.mp4"/>
                                    </group>
                                </group>
                                <group col="4" invisible="hero_choice != 'youtube'">
                                    <group>
                                        <field name="youtube_bg_video" placeholder="iTPtpU-IpiM"/>
                                    </group>
                                </group>
                                <group col="4" invisible="hero_choice not in ['vid', 'youtube']">
                                    <group>
                                        <field name="mob_background" widget="image" style="width:25%!important;"/>
                                    </group>
                                </group>
                                <group col="4" string="Search Section Backgrounds" invisible="hero_choice != 'img'">
                                    <group>
                                        <field name="image_1920_0" widget="image" style="width:25%!important;"/>
                                    </group>
                                    <group>
                                        <field name="image_1920_1" widget="image" style="width:25%!important;"/>
                                    </group>
                                    <group>
                                        <field name="image_1920_2" widget="image" style="width:25%!important;"/>
                                    </group>
                                    <group>
                                        <field name="image_1920_3" widget="image" style="width:25% !important;"/>
                                    </group>
                                </group>
                                <group col="2" string="Stats BG &amp; Promo Video BG">
                                    <group>
                                        <field name="sec_img_2" widget="image" style="width:25%!important;"/>
                                    </group>
                                    <group>
                                        <field name="sec_img_3" widget="image" style="width:25%!important;"/>
                                    </group>
                                </group>
                            </page>
                            <page name="theme_color_configuration" string="Theme Color Configuration">
                                <button name="action_reset_theme_colors" type="object"
                                        string="Reset Colors" class="btn btn-outline-primary"
                                        confirm="Are you sure you want to reset theme color?"/>
                                <group string="Theme Main Background" name="theme_main_background">
                                    <group>
                                        <field name="primary_background" widget="color"/>
                                    </group>
                                    <group>
                                        <field name="secondary_background" widget="color"/>
                                    </group>
                                </group>
                                <group string="Button Colors" name="button_colors">
                                    <group>
                                        <field name="btn_primary" widget="color"/>
                                        <field name="btn_primary_text" widget="color"/>
                                    </group>
                                    <group>
                                        <field name="emphasis_background" widget="color"/>
                                        <field name="btn_secondary_text" widget="color"/>
                                    </group>
                                </group>
                                <group string="Other Colors" name="other_colors">
                                    <group>
                                        <field name="text_color" widget="color"/>
                                        <field name="header_color" widget="color"/>
                                    </group>
                                    <group>
                                        <field name="link_color" widget="color"/>
                                        <field name="header_text" widget="color"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="property_theme_config_action" model="ir.actions.act_window">
            <field name="name">Property Theme Configuration</field>
            <field name="res_model">property.theme.config</field>
            <field name="view_mode">form</field>
            <field name="res_id" ref="tk_website_rental_management.property_theme_config_rec"/>
        </record>

        <menuitem name="Property Theme Config"
                  id="menu_property_theme_config"
                  parent="rental_management.menu_configuration"
                  groups="rental_management.property_rental_manager,rental_management.property_rental_officer"
                  action="property_theme_config_action"/>
    </data>
</odoo>
