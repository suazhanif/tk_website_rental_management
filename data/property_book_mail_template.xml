<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="landlord_enquiry_notification_mail_template" model="mail.template">
            <field name="name">Landlord Inquiry Notification Email Template</field>
            <field name="model_id" ref="rental_management.model_crm_lead"/>
            <field name="subject">New Inquiry Received for Your Property - {{object.property_id.name}}</field>
            <field name="email_from">{{object.company_id.email}}</field>
            <field name="partner_to">{{ object.property_id.landlord_id.id }}</field>
            <field name="body_html" type="html">
                <p>Dear <strong t-esc="object.property_id.landlord_id.name" />,</p>

                <p>We are pleased to inform you that a potential tenant has submitted an inquiry regarding your property, <strong t-esc="object.property_id.name" />. Below are the details of the inquiry:</p>

                <h4>Inquiry Details:</h4>

                <strong>Name:</strong> <span t-field="object.contact_name" />
                <br/>
                <strong>Email:</strong> <span t-field="object.email_from" />
                <br/>
                <strong>Phone:</strong> <span t-field="object.phone" />
                <br/>
                <strong>Message:</strong> <span t-field="object.description" />
                <br/>
                <strong>Inquiry Date:</strong> <span t-field="object.create_date" t-options="{ 'format': 'MM/dd/YYYY' }" />

                <p>Please reach out to the interested party at your earliest convenience to discuss further details or schedule a property viewing.</p>

                <p>If you have any questions or need assistance, feel free to contact us at <strong><a t-attf-href="tel://{{ object.company_id.phone }}" t-esc="object.company_id.phone" /></strong>.</p>

                <p>Thank you for using <strong t-esc="object.company_id.name" /> to manage your property. We look forward to helping you secure a tenant soon!</p>

                <h4>
                    Best regards
                </h4>
                <h5>
                    <strong>
                        <t t-esc="object.company_id.name"/>
                    </strong>
                </h5>
                <hr/>
                <span>
                    <h4>
                        <t t-esc="object.company_id.name"/>
                    </h4>
                    <t t-esc="object.company_id.phone"/>
                    <br/>
                    <t t-esc="object.company_id.email"/>
                    <br/>
                    <t t-esc="object.company_id.website"/>
                </span>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>